<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-shrinking spinner closed-state view. Used by spinners whose
  selected text can be longer than the fixed-width box (e.g. "Armaments"
  in the Theme spinner). The dropdown list keeps using
  spinner_dropdown_item.xml so opened items render at full size.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:textColor="#000000"
    android:maxLines="1"
    android:paddingBottom="5dp"
    android:paddingTop="5dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    app:autoSizeTextType="uniform"
    app:autoSizeMinTextSize="10sp"
    app:autoSizeMaxTextSize="@dimen/text_spinner"
    app:autoSizeStepGranularity="1sp" />
