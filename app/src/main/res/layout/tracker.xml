<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tracker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/textView_nexus5"
            android:text="@string/tracker_active_campaign"
            android:layout_marginTop="0dp"/>

        <Spinner
            style="@style/spinner_nexus5"
            android:id="@+id/tracker_campaign_spinner"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/tracker_new"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tracker_new"/>

            <Button
                android:id="@+id/tracker_rename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tracker_rename"/>

            <Button
                android:id="@+id/tracker_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tracker_reset"/>

            <Button
                android:id="@+id/tracker_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tracker_delete"/>
        </LinearLayout>

        <TextView
            style="@style/textView_nexus5"
            android:text="@string/tracker_grid_heading"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/tracker_grid_subheading"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:gravity="center"/>

        <TableLayout
            android:id="@+id/tracker_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>

        <TextView
            android:id="@+id/tracker_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/tracker_view_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tracker_view_history"/>
    </LinearLayout>
</ScrollView>
