<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet landscape Spells tab. Big Generate Spell button on the right;
  the two spinner BOXES align to the button's edges - the top spinner's
  top edge meets the button top, the bottom spinner's bottom edge meets
  the button bottom. Each label floats just above its spinner (the top
  label sits above the button top). RelativeLayout is used so the spinner
  boxes can be pinned to the button's top/bottom edges directly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spells"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="48dp"
        android:paddingRight="48dp">

        <!-- Top spinner's label, sits above the top spinner (above button top). -->
        <TextView
            android:id="@+id/class_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="@string/spell_class"
            android:textColor="@color/black"
            android:textSize="26sp"/>

        <!-- Top spinner: top edge anchors the button's top. -->
        <Spinner
            android:id="@+id/class_spinner"
            android:layout_width="280dp"
            android:layout_height="85dp"
            android:layout_below="@id/class_label"
            android:layout_alignParentStart="true"
            android:background="@drawable/spinner_design_external"
            android:gravity="center"/>

        <!-- Button: tall; its top aligns to the top spinner's top. -->
        <Button
            android:id="@+id/spell_send"
            android:layout_width="380dp"
            android:layout_height="260dp"
            android:layout_alignTop="@id/class_spinner"
            android:layout_toEndOf="@id/class_spinner"
            android:layout_marginStart="64dp"
            android:background="@drawable/button_design"
            android:onClick="generate"
            android:text="@string/spell_send"
            android:textSize="32sp"/>

        <!-- Bottom spinner: bottom edge anchors the button's bottom. -->
        <Spinner
            android:id="@+id/level_spinner"
            android:layout_width="280dp"
            android:layout_height="85dp"
            android:layout_alignBottom="@id/spell_send"
            android:layout_alignParentStart="true"
            android:background="@drawable/spinner_design_external"
            android:gravity="center"/>

        <!-- Bottom spinner's label, just above the bottom spinner. -->
        <TextView
            android:id="@+id/level_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/level_spinner"
            android:layout_alignParentStart="true"
            android:text="@string/level"
            android:textColor="@color/black"
            android:textSize="26sp"/>

    </RelativeLayout>
</FrameLayout>
