<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet landscape Tracker tab. Splits the screen horizontally so
  everything fits without scrolling: grid + heading on the left, the
  four action buttons (stacked) + total + View Awarded Items button
  on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Left: heading + grid (top-aligned) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical">

        <TextView
            style="@style/textView_nexus5"
            android:text="@string/tracker_grid_heading"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/tracker_grid_subheading"
            android:textColor="@color/black"
            android:textSize="@dimen/text_tracker_subheading"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:gravity="center"/>

        <TableLayout
            android:id="@+id/tracker_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:shrinkColumns="*"/>

    </LinearLayout>

    <!-- Right: action buttons + total + history -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/tracker_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_tracker_button"
            android:text="@string/tracker_new"/>

        <Button
            android:id="@+id/tracker_rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="@dimen/text_tracker_button"
            android:text="@string/tracker_rename"/>

        <Button
            android:id="@+id/tracker_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="@dimen/text_tracker_button"
            android:text="@string/tracker_reset"/>

        <Button
            android:id="@+id/tracker_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="@dimen/text_tracker_button"
            android:text="@string/tracker_delete"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tracker_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/text_tracker_total"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/tracker_view_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="@dimen/text_tracker_button"
            android:text="@string/tracker_view_history"/>

    </LinearLayout>
</LinearLayout>
