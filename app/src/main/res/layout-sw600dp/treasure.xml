<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet (sw600dp+) portrait layout for the Treasure tab. Centered
  column with generous sizing. Wrapped in a ScrollView so Hoard mode
  (four spinners + button) scrolls instead of clipping the Generate
  button; fillViewport + gravity=center keeps it centered when it fits.
-->
<!-- No root id: the landscape root is a different view class with the same
     conceptual role, and sharing an id across configs crashes on rotation
     (ScrollView.SavedState vs AbsSavedState ClassCastException). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:paddingLeft="48dp"
        android:paddingRight="48dp">

        <RadioGroup
            android:id="@+id/radio_encounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:checkedButton="@+id/radio_individual"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_individual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/individual"
                android:textSize="34sp"/>

            <RadioButton
                android:id="@+id/radio_hoard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:text="@string/hoard"
                android:textSize="34sp"/>
        </RadioGroup>

        <TextView
            android:id="@+id/challenge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="@string/challenge"
            android:textColor="@color/black"
            android:textSize="34sp"/>

        <Spinner
            android:id="@+id/challenge_spinner"
            android:layout_width="380dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/spinner_design_external"
            android:gravity="center"/>

        <TextView
            android:id="@+id/party_level_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="@string/party_level"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:visibility="gone"/>

        <Spinner
            android:id="@+id/party_level_spinner"
            android:layout_width="380dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/spinner_design_external"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/theme_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="@string/theme"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:visibility="gone"/>

        <Spinner
            android:id="@+id/theme_spinner"
            android:layout_width="380dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/spinner_design_external"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="@string/iterations"
            android:textColor="@color/black"
            android:textSize="34sp"/>

        <Spinner
            android:id="@+id/iteration_spinner"
            android:layout_width="380dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/spinner_design_external"
            android:gravity="center"/>

        <Button
            android:id="@+id/treasure_send"
            android:layout_width="480dp"
            android:layout_height="168dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="44dp"
            android:background="@drawable/button_design"
            android:onClick="generate"
            android:text="@string/treasure_send"
            android:textSize="34sp"/>

    </LinearLayout>
</ScrollView>
